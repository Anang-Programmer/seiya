NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used to create username accounts; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Optional: Gemini provider + RAG knowledge search (chat still works without it).
GOOGLE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
APP_BASE_URL=http://localhost:3000
# Optional: "Continue with WeChat". Server-only; set either pair (or both).
# Inside the WeChat app: Official Account web authorization. The free sandbox
# test account (测试号) works here: https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# Any browser (QR login): Open Platform Website Application (paid verification).
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Shows the auth-flow screen switcher for design review. Keep false in production.
NEXT_PUBLIC_ENABLE_DEMO_SIMULATION=false
SEIYA_AI_GROQ_MODEL=openai/gpt-oss-120b
SEIYA_AI_GEMINI_MODEL=gemini-3.8-flash
SEIYA_AI_MISTRAL_MODEL=ministral-8b-latest
SEIYA_AI_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
SEIYA_AI_CLOUDFLARE_MODEL=@cf/meta/llama-3.2-1b-instruct
SEIYA_AI_CLOUDFLARE_ENABLE_TOOLS=false

SEIYA_AI_PROVIDER_ORDER=groq,mistral,openrouter,cloudflare
SEIYA_AI_PRIVATE_PROVIDER_ALLOWLIST=groq,mistral,openrouter
SEIYA_AI_PROVIDER_TIMEOUT_MS=7000
SEIYA_AI_MAX_PROVIDER_ATTEMPTS=4
SEIYA_AI_PROVIDER_COOLDOWN_MS=30000


# Cloudflare https://developers.cloudflare.com/workers-ai/
# Groq https://console.groq.com/keys
# Openrouter https://openrouter.ai/workspaces/default/keys
# Google API Key https://aistudio.google.com/api-keys
# Mistral https://console.mistral.ai/api-keys