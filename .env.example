NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
APP_BASE_URL=http://localhost:3000
SEIYA_AI_GROQ_MODEL=openai/gpt-oss-120b
SEIYA_AI_GEMINI_MODEL=gemini-3.8-flash
SEIYA_AI_MISTRAL_MODEL=ministral-8b-latest
SEIYA_AI_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
SEIYA_AI_CLOUDFLARE_MODEL=@cf/meta/llama-3.2-1b-instruct
SEIYA_AI_CLOUDFLARE_ENABLE_TOOLS=false

SEIYA_AI_PROVIDER_ORDER=groq,gemini,mistral,openrouter,cloudflare
SEIYA_AI_PRIVATE_PROVIDER_ALLOWLIST=groq,gemini,mistral
SEIYA_AI_PROVIDER_TIMEOUT_MS=7000
SEIYA_AI_MAX_PROVIDER_ATTEMPTS=4
SEIYA_AI_PROVIDER_COOLDOWN_MS=30000


# Cloudflare https://developers.cloudflare.com/workers-ai/
# Groq https://console.groq.com/keys
# Openrouter https://openrouter.ai/workspaces/default/keys
# Google API Key https://aistudio.google.com/api-keys
